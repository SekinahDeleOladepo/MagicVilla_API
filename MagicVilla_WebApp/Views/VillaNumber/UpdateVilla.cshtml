@model MagicVilla_WebApp.Model.Dto.VillaNumberCreateDTO

@{
    ViewData["Title"] = "Create Villa";
}

<div class="container mt-5">
    <h2 class="mb-4"><i class="bi bi-building"></i> Create New Villa</h2>

    <form asp-action="UpdateVilla" method="post" class="needs-validation" novalidate>
        @Html.AntiForgeryToken()
        <div class="mb-3">
            <label asp-for="VillaNo" class="form-label">
                <i class="bi bi-tag-fill text-primary"></i> @Html.DisplayNameFor(m => m.VillaNo)
            </label>
            <input asp-for="VillaNo" class="form-control" />
            <div class="text-danger" asp-validation-for="Name"></div>
        </div>

        <div class="mb-3">
            <label asp-for="VillaID" class="form-label">
                <i class="bi bi-card-text text-primary"></i> @Html.DisplayNameFor(m => m.VillaID)
            </label>
            <textarea asp-for="VillaID" class="form-control" rows="4"></textarea>
            <div class="text-danger" asp-validation-for="Details"></div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="SpecialDetails" class="form-label">
                    <i class="bi bi-currency-dollar text-success"></i> @Html.DisplayNameFor(m => m.SpecialDetails)
                </label>
                <input asp-for="SpecialDetails" class="form-control" type="number" step="0.01" />
                <div class="text-danger" asp-validation-for="SpecialDetails"></div>
            </div>

        <div class="d-flex justify-content-between mt-4">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-save"></i> Update Villa
            </button>
            <a asp-action="IndexVilla" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Cancel
            </a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
